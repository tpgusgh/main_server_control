# Copy to .env (chmod 600) and fill in. systemd loads it via EnvironmentFile.

# --- login ---
SM_PASSWORD='change-me-at-least-11-chars'      # dashboard password (11+ chars). Change → everyone is logged out
SM_TRUSTED_IPS=                                 # never banned (still need the password), e.g. 203.0.113.10,198.51.100.0/24
SM_IP_LABELS=                                   # display names, e.g. 203.0.113.10=me,198.51.100.5=office

# --- public URL / Cloudflare ---
SM_HOST=hi.example.com                          # public hostname behind the Cloudflare tunnel
SM_PORT=8100                                    # local port (bound to 127.0.0.1 only)
SM_CF_TEAM_DOMAIN=yourteam.cloudflareaccess.com # Cloudflare Access team domain (empty = JWT check off)
SM_CF_AUD=                                      # Access application AUD tag
SM_CF_ALLOWED_EMAILS=                           # optional extra allow-list for the Access JWT email

# --- alerts (any of them) ---
SM_DISCORD_BOT_TOKEN=                           # bot token; alerts are sent as DMs to SM_DISCORD_USER_ID
SM_DISCORD_USER_ID=
SM_DISCORD_CHANNEL_ID=                          # or a channel instead of a DM
SM_DISCORD_WEBHOOK=
SM_TELEGRAM_BOT_TOKEN=
SM_TELEGRAM_CHAT_ID=
SM_HEARTBEAT_URL=                               # e.g. https://hc-ping.com/<uuid> — alerts you when this machine is down

# --- local LLM (llama.cpp llama-server) ---
SM_LLM_URL=http://127.0.0.1:8180
SM_LLM_API_KEY=                                 # same value as LLAMA_API_KEY in the llm.service env file
SM_AI_BRIEFING_HOURS=0                          # extra periodic briefing every N hours (0 = only the nightly reports)
SM_TZ=Asia/Seoul
